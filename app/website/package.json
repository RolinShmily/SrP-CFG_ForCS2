  "repository": {
    "type": "git",
    "url": "git+https://github.com/RolinShmily/SrP-CFG_ForCS2.git",
    "directory": "app/website"
  },
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/sync-fonts.mjs && node ../../scripts/extract-keymaps.mjs && node ../../scripts/extract-crosshair.mjs && vite dev",
    "build": "node ../../scripts/sync-fonts.mjs && node ../../scripts/extract-keymaps.mjs && node ../../scripts/extract-crosshair.mjs && velite --clean && react-router build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && npx wrangler deploy",
    "test:ai-stream": "node --experimental-strip-types --test src/lib/ai-stream.test.ts"
  },
  "dependencies": {
    "@react-router/node": "^7.18.2",
    "@srp-cfg/ui": "workspace:*",
    "isbot": "^5",
    "lucide-react": "^1.47.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^4.1.6",
    "typescript": "~7.0.2",
    "velite": "0.4.0",
    "vite": "^6.4.2"
  }
}
