root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,yml,yaml,css,scss,html,svg}]
indent_size = 2

[*.{cpp,cc,cxx,h,hpp,inl}]
indent_size = 4

[*.{cmake,txt}]
indent_size = 4

[*.qml]
indent_size = 4

[*.cfg]
indent_size = 4

[*.{ps1,bat,cmd}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
