{
  "name": "srp-cfg-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "predev": "pnpm console:prepare && pnpm seo:build",
    "prebuild": "pnpm console:prepare && pnpm seo:build",
    "build": "react-router build",
    "preview": "node scripts/preview.mjs",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "licenses:collect": "node scripts/collect-licenses.mjs",
    "seo:build": "node scripts/seo/build-sitemap.mjs",
    "console:prepare": "python3 scripts/console/validate.py --allow-stale && python3 scripts/console/build_index.py",
    "console:update": "python3 scripts/console/update.py",
    "console:translate": "python3 scripts/console/translate.py",
    "console:validate": "python3 scripts/console/validate.py",
    "console:index": "python3 scripts/console/build_index.py",
    "console:test": "python3 -m unittest discover -s scripts/console -p \"test_*.py\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.5.1",
    "tailwind-merge": "^3.7.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
