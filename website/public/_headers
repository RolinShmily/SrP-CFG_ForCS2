/packages.json
  Cache-Control: no-store

/packages/*
  Cache-Control: public, max-age=0, must-revalidate

/data/console-index.json
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600

/assets/*
