{
  "name": "srp-cfg-monorepo",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev:web": "pnpm --filter @srp-cfg/website dev",
    "build:web": "pnpm --filter @srp-cfg/website build",
    "install:web": "pnpm install --filter @srp-cfg/website...",
    "deploy:web": "pnpm install:web && pnpm --filter @srp-cfg/website run deploy",
    "check:types": "pnpm --filter @srp-cfg/website typecheck && pnpm --filter @srp-cfg/desktop typecheck",
    "preview:web": "pnpm --filter @srp-cfg/website preview",
    "dev:desktop": "pnpm --filter @srp-cfg/desktop start",
    "build:desktop": "pnpm --filter @srp-cfg/desktop build",
    "package:desktop": "pnpm --filter @srp-cfg/desktop package",
    "sync:version": "node app/desktop/scripts/sync-tauri-version.mjs",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "gen:licenses": "node scripts/generate-third-party-licenses.mjs",
    "check:licenses": "node scripts/generate-third-party-licenses.mjs --check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}